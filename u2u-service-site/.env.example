# Public NEWS pages: Firestore REST read for published articles
NEWS_FIRESTORE_PROJECT_ID=your-firebase-project-id
NEWS_FIRESTORE_DATABASE_ID=(default)
NEWS_FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# NEWS CMS: Firebase Auth / Firestore / Storage client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Leave unset when deploying at https://u2u.heyl.co.jp
# Optional only when deploying under heyl.co.jp/u2u
NEXT_PUBLIC_BASE_PATH=/u2u

# Public ForU / FromU pages: server-side Firebase Admin SDK access.
# Set these only in Vercel environment variables. Do not commit real secrets.
U2U_FIREBASE_PROJECT_ID=unicorn1111
U2U_FIREBASE_CLIENT_EMAIL=your-service-account@unicorn1111.iam.gserviceaccount.com
U2U_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional. Defaults to (default).
U2U_FIRESTORE_DATABASE_ID=(default)
